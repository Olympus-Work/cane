# Copy to apps/server/.env for local development. .env is git-ignored; never commit it.
# Only placeholders here. Production values live in the Railway environment.

# --- Server (see README "Configuration") ---
PORT=3000
# Order-placing master switch. Keep false outside the production deploy.
TRADING_ENABLED=false
# testnet | live. Keep testnet outside the production deploy.
BINANCE_ENV=testnet
# Encrypts secrets stored in the DB (32 bytes, base64). Local: any random value, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CANE_MASTER_KEY=
# Jev API key. Leave empty locally unless making a live Jev call.
TYPESAFE_API_KEY=

# --- Database ---
# Local throwaway Postgres (README "Database"). Tests drop the public schema: never a real DB.
DATABASE_URL=postgres://postgres:postgres@localhost:55432/postgres

# --- Binance TESTNET keys: integration tests only (plan steps 5, 6, 11) ---
# The server never reads these. Its Binance keys come only from Settings,
# stored encrypted (spec B15). Never put live keys here.
# Create keys in Binance Demo Trading: https://demo.binance.com/en/my/settings/api-management
# (Binance's current testnet: REST demo-api.binance.com for spot, demo-fapi.binance.com for USDⓈ-M).
BINANCE_SPOT_TESTNET_KEY=
BINANCE_SPOT_TESTNET_SECRET=
BINANCE_FUTURES_TESTNET_KEY=
BINANCE_FUTURES_TESTNET_SECRET=
